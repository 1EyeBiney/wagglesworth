# Source archives: the preserved originals, never modified, never committed as
# binary blobs. Kept on disk locally as the record of exactly what was received.
*.zip

# The raw zip extraction: a working copy used for the Phase 1 inventory and as
# provenance reference, NOT what the build pipeline reads from. The image
# pipeline's actual input is assets/originals/ (tracked below, since GitHub
# Actions builds the site and needs the real files, not just this local folder).
_source/

# Node
node_modules/

# Eleventy build output — regenerated by `npm run build`, never hand-edited.
_site/

# Generated image derivatives — regenerated by the image pipeline from _source/
# plus data/images.json. Disposable.
assets/img/derived/

# OS/editor noise
.DS_Store
Thumbs.db
desktop.ini

# Local env
.env
