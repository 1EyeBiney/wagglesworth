<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }} — {% endif %}{{ site.name }}</title>
    {% if description %}<meta name="description" content="{{ description }}">{% endif %}
    {% if not site.goLiveToSearchEngines %}
    {# Single documented switch: see DECISIONS_AND_GAPS.md / site.json
       "goLiveToSearchEngines". Do not remove without Barb's go-ahead. #}
    <meta name="robots" content="noindex, nofollow">
    {% endif %}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/assets/css/main.css">
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    {% include "partials/nav.njk" %}
    <main id="main-content" class="page-content">
        {{ content | safe }}
    </main>
    {% include "partials/footer.njk" %}
    <script src="/assets/js/text-size.js"></script>
    {% if extraScripts %}
    {% for src in extraScripts %}<script src="{{ src }}"></script>
    {% endfor %}
    {% endif %}
</body>
</html>
